{
  "processor_class": "ZootProcessor",
  "auto_map": {
    "AutoProcessor": "processing_zoot.ZootProcessor"
  },
  "do_normalize": true,
  "do_rescale": true,
  "do_resize": true,
  "do_center_crop": true,
  "Columbia National Defense Budget": true,
  "CONAL-DB": [
    "847B LMD,R&D: 12%.",
    "Personnel: 43%",
    "Equipment: 28%. Intelligence: 17%."
  ],
  "image_std": [
    0.229,
    0.224,
